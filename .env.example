# Product configuration only. Fill local development values in ignored .env.
APP_ENV=development
APP_PORT=8001
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://127.0.0.1:8001
AI_SERVICE_MODE=mock
AI_SERVICE_BASE_URL=
AI_SERVICE_API_KEY=
AI_SERVICE_CONNECT_TIMEOUT_SECONDS=5
AI_SERVICE_POOL_TIMEOUT_SECONDS=5
AI_SERVICE_WRITE_TIMEOUT_SECONDS=30
AI_SERVICE_READ_TIMEOUT_SECONDS=120
AI_SERVICE_DEADLINE_SECONDS=120
PRODUCT_REQUEST_DEADLINE_SECONDS=135
AI_SERVICE_MAX_CONNECTIONS=10
AI_SERVICE_MAX_KEEPALIVE_CONNECTIONS=5
AI_SERVICE_MAX_CONCURRENCY=4
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PASSWORD=
SUPABASE_AUTH_MODE=get_user
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_URL=
MIGRATION_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_SECONDS=15
# Baseline from ADR-0002; update contract/UI/tests if changed to ALL.
HISTORY_POLICY=REVIEW_REQUIRED
HISTORY_RETENTION_DAYS=90
IDEMPOTENCY_CACHE_TTL_SECONDS=600
PREVIEW_TTL_SECONDS=900
SIGNED_URL_TTL_SECONDS=300
STORE_SCREENSHOTS_ENABLED=false
SCREENSHOT_RETENTION_HOURS=24
MAX_IMAGE_BYTES=8000000
COMMUNITY_RAG_SYNC_ENABLED=false
DEBUG_ENABLED=false
